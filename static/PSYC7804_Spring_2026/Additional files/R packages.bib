@article{Kroes_Finley_2025,
  title = {Demystifying Omega Squared: {{Practical}} Guidance for Effect Size in Common Analysis of Variance Designs},
  shorttitle = {Demystifying Omega Squared},
  author = {Kroes, Antoinette D. A. and Finley, Jason R.},
  year = 2025,
  month = aug,
  journal = {Psychological Methods},
  volume = {30},
  number = {4},
  pages = {866--887},
  issn = {1939-1463},
  doi = {10.1037/met0000581},
  abstract = {Omega squared ({$\omega$}\textasciicircum 2) is a measure of effect size for analysis of variance (ANOVA) designs. It is less biased than eta squared, but reported less often. This is in part due to lack of clear guidance on how to calculate it. In this paper, we discuss the logic behind effect size measures, the problem with eta squared, the history of omega squared, and why it has been underused. We then provide a user-friendly guide to omega squared and partial omega squared for ANOVA designs with fixed factors, including one-way, two-way, and three-way designs, using within-subjects factors and/or between-subjects factors. We show how to calculate omega squared using output from SPSS. We provide information on the calculation of confidence intervals. We examine the problems of nonadditivity, and intrinsic versus extrinsic factors. We argue that statistical package developers could play an important role in making the calculation of omega squared easier. Finally, we recommend that researchers report the formulas used in calculating effect sizes, include confidence intervals if possible, and include ANOVA tables in the online supplemental materials of their work. (PsycInfo Database Record (c) 2025 APA, all rights reserved).},
  langid = {english},
  pmid = {37471015},
  keywords = {Analysis of Variance,Data Interpretation Statistical,Humans,Psychology,Research Design},
  file = {/home/fsetti/Dropbox/Zotmoov_sync/Courses/PSYC 6802/Kroes and Finley - 2025 - Demystifying omega squared Practical guidance for effect size in common analysis of variance design.pdf}
}

