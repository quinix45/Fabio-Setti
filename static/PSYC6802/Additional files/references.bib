  pages = {3--24},
  publisher = {Sage Publications},
  address = {US},
  issn = {1552-3497},
  doi = {10.1177/0146621602026001001},
  abstract = {Notes that item response theory item parameters (IPs) can be estimated using data from a common-item equating design either separately for each form or concurrently across forms. This paper reports the results of a simulation study of separate vs concurrent IP estimation. Using simulated data from 2 test forms with 60 dichotomous items, 4 factors were considered: (1) estimation program (MULTILOG vs BILOG-MG), (2) sample size per form (3,000 vs 1,000), (3) number of common items (20 vs 10), and (4) equivalent vs nonequivalent groups taking the 2 forms (no mean difference vs a mean difference of 1 SD). In addition, 4 methods of IP scaling were used in the separate estimation condition: 2 item characteristic curve methods (Stocking-Lord and Haebara) and 2 moment methods (Mean/Mean and Mean/Sigma). Concurrent estimation generally resulted in lower error than separate estimation, although not universally. The results suggest that 1 factor accounting for the lower error when using concurrent estimation may be that the parameter estimates for the common IPs are based on larger samples. It is argued that the results of this study, together with other research on this topic, are not sufficient to recommend completely avoiding separate estimation in favor of concurrent estimation. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {/unread,Item Analysis (Statistical),Item Response Theory,Statistical Estimation},
  file = {/home/fsetti/Zotero/storage/2F84NL7S/Hanson and Béguin - 2002 - Obtaining a common scale for item response theory .pdf}
}

