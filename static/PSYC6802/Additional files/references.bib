  keywords = {Open science,Pre-registration,Researcher bias,Secondary data analysis},
  file = {/home/fsetti/Zotero/storage/4JU9GF4Q/Baldwin et al. - 2022 - Protecting against researcher bias in secondary da.pdf}
}

