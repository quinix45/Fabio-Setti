  keywords = {/unread,Bifactor,Construct validity,Criterion validity,General psychopathology factor,Humans,Mental Disorders,Models Statistical,Neurobiology,Nomological net,Psychiatry,Psychopathology,Structural equations modeling,Taxonomy},
