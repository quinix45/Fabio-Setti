@article{Davis_etal_2014,
  title = {What {{Do Differences Between Multi-voxel}} and {{Univariate Analysis Mean}}? {{How Subject-}}, {{Voxel-}}, and {{Trial-level Variance Impact fMRI Analysis}}},
