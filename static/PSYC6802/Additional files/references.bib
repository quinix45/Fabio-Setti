@article{Reise_etal_2010,
  title = {Bifactor {{Models}} and {{Rotations}}: {{Exploring}} the {{Extent}} to Which {{Multidimensional Data Yield Univocal Scale Scores}}},
  shorttitle = {Bifactor {{Models}} and {{Rotations}}},
  author = {Reise, Steven P. and Moore, Tyler M. and Haviland, Mark G.},
  year = 2010,
