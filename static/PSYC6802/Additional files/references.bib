@article{Li_Shin_2025,
  title = {An {{Extended Two-Parameter Logistic Item Response Model}} to {{Handle Continuous Responses}} and {{Sparse Polytomous Responses}}},
  author = {Li, Seewoo and Shin, Hyo Jeong},
  year = 2025,
  month = sep,
  journal = {Psychometrika},
  volume = {90},
